# Use credentials for your existing PostgreSQL instance. URL-encode special characters.
# Local workspace: postgres-local container on port 5434, dedicated database avenra.
DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5434/avenra
# Browser origins allowed to call this API. Set explicitly for your frontend deployment.
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:4173"]
