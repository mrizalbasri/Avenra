{
  "name": "avenra",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @avenra/web dev --host 127.0.0.1",
    "build": "pnpm --filter @avenra/web build",
    "check": "pnpm --filter @avenra/web check",
    "test:e2e": "pnpm --filter @avenra/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "prettier-plugin-svelte": "^3.4.0"
  }
}
